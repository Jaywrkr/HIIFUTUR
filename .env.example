# --- Vercel Postgres (Storage -> Postgres, generated automatically) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- One-time setup endpoint (/api/setup/migrate) ---
# Any string you choose. Visit /api/setup/migrate?secret=<this-value> once after
# deploy to create the database tables if you can't run `npm run db:migrate`
# from a terminal (e.g. deploying purely from the Vercel dashboard).
SETUP_SECRET=

# --- Password reset emails (Resend: https://resend.com) ---
# Without these, reset links are printed to the server console instead of
# emailed — fine for local dev, not for production.
RESEND_API_KEY=
EMAIL_FROM="EJECUTA <onboarding@resend.dev>"
