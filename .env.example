# --- Vercel Postgres (Storage -> Postgres, generated automatically) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Public site URL ---
# Used on shared images (streak/Wheel of Life cards) so someone who sees a
# share actually has a way back to the app. Set this to the real domain once
# it's live; falls back to the current Vercel URL until then.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- One-time setup endpoint (/api/setup/migrate) ---
# Disabled by default. Migrations normally run in the build (`vercel-build`), so
# you rarely need this. To use it: set SETUP_MIGRATE_ENABLED=1 AND SETUP_SECRET,
# visit /api/setup/migrate?secret=<this-value> once, then set the flag back to 0.
# While SETUP_MIGRATE_ENABLED is not "1" the endpoint returns 404.
SETUP_MIGRATE_ENABLED=0
SETUP_SECRET=

# --- Password reset + daily reminder emails (Resend: https://resend.com) ---
# Without these, emails are printed to the server console instead of sent —
# fine for local dev, not for production.
RESEND_API_KEY=
EMAIL_FROM="EJECUTA <onboarding@resend.dev>"

# --- Daily reminder cron (/api/cron/reminders, see vercel.json) ---
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Push notifications (Web Push, no third-party account needed) ---
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the SAME value —
# one is read server-side (sending), the other client-side (subscribing).
# Without these, push notifications are silently skipped (reminders still
# send by email); nothing breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT="mailto:jaywrkr@gmail.com"

# --- Feedback widget notifications ---
# Where "Feedback" button submissions get emailed. Defaults to jaywrkr@gmail.com
# if unset. Feedback is always saved to the DB regardless.
FEEDBACK_TO_EMAIL=

# --- Analitica interna (/admin/analytics) ---
# Que email puede ver el embudo de producto. Defaults a jaywrkr@gmail.com.
ADMIN_EMAIL=

# --- Error monitoring (Sentry: https://sentry.io) ---
# Without these, errors just aren't reported anywhere — no crash, no-op.
# NEXT_PUBLIC_SENTRY_DSN and SENTRY_DSN are usually the same DSN value.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional, only needed to upload source maps for readable stack traces:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- PayPal (trial + subscriptions) ---
# Sandbox vs. Live is this one flag — everything else is just which set of
# credentials you paste in. Get Sandbox credentials from
# https://developer.paypal.com, Live credentials from the same place under
# your Live app. Plan IDs come from running `scripts/create-paypal-plans.ts`
# against whichever set of credentials you're using.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_MENSUAL_NORMAL=
PAYPAL_PLAN_ID_MENSUAL_DESCUENTO=
PAYPAL_PLAN_ID_ANUAL_NORMAL=
PAYPAL_PLAN_ID_ANUAL_DESCUENTO=

# --- Google Search Console ---
# The verification meta tag value from Search Console (Settings ->
# Ownership verification -> HTML tag -> copy just the content="..." value).
# Without it, the site just doesn't have a Search Console verification tag —
# nothing breaks.
GOOGLE_SITE_VERIFICATION=

# --- Meta Pixel (Facebook/Instagram ads) ---
# From Meta Events Manager, only needed if/when running paid social ads.
# Without it, the pixel script just doesn't render — no-op.
NEXT_PUBLIC_META_PIXEL_ID=
